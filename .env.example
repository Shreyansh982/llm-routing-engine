# Cloud backend connection configuration. Keep real keys only in .env.
OPENROUTER_API_KEY=
GROQ_API_KEY=
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
GROQ_ENDPOINT=https://api.groq.com/openai/v1/chat/completions

PRIMARY_ROUTER_BACKEND=openrouter
PRIMARY_ROUTER_MODEL=qwen/qwen3-8b
FALLBACK_ROUTER_BACKEND=groq
FALLBACK_ROUTER_MODEL=llama-3.3-70b-versatile
MAX_RETRIES=3
REQUEST_TIMEOUT=60

# The Router only receives the IDs and abstract capabilities below. Backend, endpoint,
# model, timeout, and credentials remain in the configuration/adapter boundary.
PROVIDERS_JSON=[{"id":"provider_a","enabled":true,"backend":"openrouter","model":"openai/gpt-oss-20b:free","capabilities":{"strengths":["reasoning","coding"],"speed_tier":"standard","context_size":"large"},"identity_terms":["GPT-OSS","OpenAI"]},{"id":"provider_b","enabled":true,"backend":"groq","model":"llama-3.1-8b-instant","capabilities":{"strengths":["general_qa","chat","summarization"],"speed_tier":"fast","context_size":"large"},"identity_terms":["Llama","Meta"]},{"id":"provider_c","enabled":true,"backend":"openrouter","model":"google/gemma-3-4b-it","capabilities":{"strengths":["creative_writing","reasoning"],"speed_tier":"standard","context_size":"large"},"identity_terms":["Gemma","Google"]}]
