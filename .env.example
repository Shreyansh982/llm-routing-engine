# Cloud backend connection configuration. Keep real keys only in .env.
GOOGLE_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

GOOGLE_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
NVIDIA_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
GROQ_ENDPOINT=https://api.groq.com/openai/v1/chat/completions

PRIMARY_ROUTER_BACKEND=google
PRIMARY_ROUTER_MODEL=gemini-3.8-flash
FALLBACK_ROUTER_BACKEND=nvidia
FALLBACK_ROUTER_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Maximum explicit conversation-level retry count. This does not configure HTTP retries.
MAX_RETRIES=3
REQUEST_TIMEOUT=20
OVERALL_REQUEST_TIMEOUT=60
MAX_IMAGE_BYTES=5242880
# Diagnostics are disabled by default. Enable only for an operator-controlled POC.
DEVELOPER_MODE_ENABLED=false
# Optional additional access control when enabled; keep the real token in .env.
DEVELOPER_TOKEN=
ROUTER_TIMEOUT=10
ROUTER_TEMPERATURE=0
ROUTER_MAX_TOKENS=128
ROUTER_REASONING_EFFORT=low

CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_OPEN_SECONDS=30
CIRCUIT_HALF_OPEN_PROBES=1

# Exactly 12 task models. Fallback order is task_group + priority; routers never receive
# these provider IDs, backend names, model IDs, priorities, credentials, or endpoints.
# G2 uses OpenRouter's paid base slug because the provider currently rejects its former
# :free variant as unavailable. Review OpenRouter pricing/quota before enabling traffic.
