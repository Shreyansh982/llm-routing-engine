# Local router endpoints must support schema-constrained JSON output. The POC uses an
# OpenAI-compatible request envelope; see README for the documented assumption.
PRIMARY_ROUTER_URL=http://localhost:11434/v1/chat/completions
PRIMARY_ROUTER_MODEL=router-primary
FALLBACK_ROUTER_URL=http://localhost:11435/v1/chat/completions
FALLBACK_ROUTER_MODEL=router-fallback
MAX_RETRIES=3
REQUEST_TIMEOUT=30

# JSON array. Provider IDs and capability descriptors are the only provider details
# the Router receives. endpoint/model/vendor mapping remains in the registry.
PROVIDERS_JSON=[{"id":"provider_a","enabled":true,"endpoint":"http://localhost:8001/v1/chat/completions","model":"model-a","capabilities":{"strengths":["reasoning","coding"],"speed_tier":"standard","context_size":"large"},"identity_terms":["Provider A"]},{"id":"provider_b","enabled":true,"endpoint":"http://localhost:8002/v1/chat/completions","model":"model-b","capabilities":{"strengths":["creative_writing","summarization"],"speed_tier":"fast","context_size":"standard"},"identity_terms":["Provider B"]},{"id":"provider_c","enabled":false,"endpoint":"http://localhost:8003/v1/chat/completions","model":"model-c","capabilities":{"strengths":["reasoning"],"speed_tier":"standard","context_size":"large"},"identity_terms":["Provider C"]}]
